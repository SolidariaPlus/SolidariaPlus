# Local development settings for compose.yaml. Copy to .env to override the defaults.
# These values are for localhost only: they are not secrets and never reach QA or Production.
POSTGRES_ADMIN_PASSWORD=local-postgres-admin
SERVICE_DB_PASSWORD=local-service-db
VALKEY_ADMIN_PASSWORD=local-valkey-admin
SERVICE_CACHE_PASSWORD=local-service-cache
KAFKA_ADMIN_PASSWORD=local-kafka-admin
KAFKA_SERVICE_PASSWORD=local-kafka-service
RABBITMQ_ADMIN_PASSWORD=local-rabbitmq-admin
GRAFANA_ADMIN_PASSWORD=local-grafana-admin
STAFF_LOCAL_PASSWORD=local-staff-password
SERVICES_CLIENT_SECRET=local-services-secret
