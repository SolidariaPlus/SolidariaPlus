  },
  "devDependencies": {
    "@solidariaplus/eslint-config": "workspace:*",
    "@solidariaplus/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "^45.4.1",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
