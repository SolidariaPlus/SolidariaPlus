{
  "name": "@solidariaplus/identity-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . && depcruise src --config .dependency-cruiser.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@solidariaplus/eslint-config": "workspace:*",
    "@solidariaplus/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.9.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@solidariaplus/auth": "workspace:*"
  }
}
